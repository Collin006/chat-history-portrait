{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:chat-history-portrait:schema:public:1.0",
  "title": "Public Chat History Portrait Package",
  "type": "object",
  "required": ["schema_version", "profile_id", "generated_at", "language", "audience", "identity_mode", "display", "patterns", "tension", "change", "open_question", "story_angles", "share_cards", "scope_note", "consent"],
  "properties": {
    "schema_version": {"const": "portrait-public/1.0"},
    "profile_id": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "language": {"type": "string", "minLength": 2},
    "audience": {"enum": ["close_circle", "public"]},
    "identity_mode": {"enum": ["anonymous", "pseudonymous", "named"]},
    "display": {
      "type": "object",
      "required": ["name", "headline", "summary"],
      "properties": {
        "name": {"type": ["string", "null"]},
        "headline": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "patterns": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "tension": {"type": "object"},
    "change": {"type": ["object", "null"]},
    "open_question": {"type": "string"},
    "story_angles": {"type": "array", "items": {"type": "object"}},
    "share_cards": {"type": "array", "items": {"type": "object"}},
    "scope_note": {"type": "string", "minLength": 1},
    "consent": {
      "type": "object",
      "required": ["approved", "approved_at", "off_limits_applied"],
      "properties": {
        "approved": {"const": true},
        "approved_at": {"type": "string", "format": "date-time"},
        "off_limits_applied": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "properties": {
        "generator": {"const": "chat-history-portrait"},
        "corpus_digest_prefix": {"type": "string", "pattern": "^[a-f0-9]{0,12}$"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
